# 2-particle Hill encounter test (independent from single-particle epicycle settings)

bParaRead       = 1
bParaWrite      = 0
bOverwrite      = 1

# Gravity ON for encounter deflection
bDoGas          = 0
bDoGravity      = 1
bDoDensity      = 0
nSmooth         = 32
dSoft           = 1.0e-4

# Time integration (100 steps per orbit)
dDelta          = 0.06283185307179587
dEta            = 0.175
dEtaCourant     = 0.4
nSteps          = 100
iLogInterval    = 1
iOutInterval    = 1
iCheckInterval  = 100

# Input / output names
achInFile       = single_particle.std
achOutName      = encounter_hill
nTreePieces     = 1
nDomainDecompose= 1

# External Hill/shearing patch setup
bDoExternalForce = 1
bPatch          = 1
dCentMass       = 1.0
dCentRad        = 0.0
dOrbDist        = 1.0

# Shear-periodic patch boundaries
bPeriodic       = 1
nReplicas       = 1
dxPeriod        = 3.8
dyPeriod        = 40.0
dzPeriod        = 4.0

bCannonical     = 1
bKDK            = 1
dMsolUnit       = 1.0
dKpcUnit        = 4.848e-9
bViscosityLimiter = 0
bViscosityLimitdt = 0
